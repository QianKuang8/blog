{{- $index := slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) -}}
        {{- $category := "" -}}
        {{- if eq .Section "topics" -}}
            {{- $category = "专题" -}}
        {{- else -}}
            {{- $categoryTitles := slice -}}
            {{- range .GetTerms "categories" -}}
                {{- $categoryTitles = $categoryTitles | append .LinkTitle -}}
            {{- end -}}
            {{- $category = delimit $categoryTitles " · " -}}
        {{- end -}}
        {{- $date := "" -}}
        {{- if not .Date.IsZero -}}
            {{- $date = .Date.Format "2006-01-02" -}}
        {{- end -}}
        {{- $tags := slice -}}
        {{- range .Params.tags -}}
            {{- $tags = $tags | append . -}}
            {{- with site.GetPage (printf "/tags/%s" .) -}}
                {{- $tags = $tags | append .LinkTitle -}}
            {{- end -}}
        {{- end -}}
        {{- /* The original's title, so a post can be found by its source. */ -}}
        {{- $record := partialCached "source_record.html" . .RelPermalink -}}
        {{- $index = $index | append (dict "title" .Title "content" (.Plain | htmlUnescape) "permalink" .Permalink "summary" (.Summary | plainify | htmlUnescape) "category" $category "date" $date "tags" (uniq $tags) "source_title" ($record.title | default "" | string)) -}}
    {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
